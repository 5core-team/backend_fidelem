# Valeurs sûres par défaut (production). En local : APP_ENV=local et APP_DEBUG=true.
APP_NAME=FIDELEM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Adresse du site : origine autorisée (CORS) et base des liens envoyés par e-mail.
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Durée de validité d'une session (jeton Sanctum), en minutes : 7 jours par défaut.
SANCTUM_EXPIRATION=10080

# Proxies dont on accepte les en-têtes X-Forwarded-* (nginx sur la même machine).
TRUSTED_PROXIES=127.0.0.1,::1

# Boîte qui reçoit les messages de contact et les candidatures.
FIDELEM_CONTACT_EMAIL=contact@fidelem.pro

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bdd_fidelem
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Envoi des e-mails (réinitialisation du mot de passe, notifications).
# En local, Mailpit capture les messages sur http://localhost:8025.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@fidelem.pro"
MAIL_FROM_NAME="${APP_NAME}"
